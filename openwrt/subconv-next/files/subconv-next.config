config subconv-next 'main'
	option enabled '1'
	option host '0.0.0.0'
	option port '9876'
	option data_dir '/etc/subconv-next/data'
	option public_base_url ''
	option log_level 'info'
	# Generated when authentication is enabled and this token is empty.
	option access_token ''
	# OpenWrt defaults to passwordless access on the local network.
	option allow_insecure_public '1'
